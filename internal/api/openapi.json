{
  "openapi": "3.0.3",
  "info": {
    "title": "HabitFlow API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register a new user",
        "responses": {
          "200": { "description": "Successful registration" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate a user",
        "responses": {
          "200": { "description": "Access and refresh tokens" }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Refresh an access token",
        "responses": {
          "200": { "description": "New token pair" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoke a refresh token",
        "responses": {
          "200": { "description": "Successfully logged out" }
        }
      }
    },
    "/api/v1/habits": {
      "get": { "summary": "List habits" },
      "post": { "summary": "Create a habit" }
    },
    "/api/v1/habits/{id}": {
      "get": { "summary": "Get a habit" },
      "put": { "summary": "Update a habit" },
      "delete": { "summary": "Delete a habit" }
    },
    "/api/v1/entries": {
      "post": { "summary": "Create an entry" }
    },
    "/api/v1/entries/{id}": {
      "delete": { "summary": "Delete an entry" }
    }
  }
}
